---
import Logo from './Logo.astro';
import { nav, links } from './site.ts';
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a href={links.home} class="brand" aria-label="Popug Cloud"><Logo /></a>
    <nav aria-label="Main">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <a class="btn btn-primary btn-sm" href={links.console}>Console</a>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 20; background: rgba(252, 251, 248, .92); backdrop-filter: blur(8px); border-bottom: 1px solid rgba(236, 234, 227, .7); }
  .hdr-in { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 56px; }
  .brand { justify-self: start; }
  nav { display: flex; gap: 30px; }
  nav a { font-size: 15px; font-weight: 500; color: var(--ink); }
  nav a:hover { color: var(--green); }
  .btn { justify-self: end; }
  @media (max-width: 720px) { nav { display: none; } .hdr-in { grid-template-columns: 1fr auto; } }
</style>
