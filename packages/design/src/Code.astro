---
import Icon from './Icon.astro';
interface Props { label?: string }
const { label } = Astro.props;
---
<div class="code">
  <div class="bar"><span class="label">{label}</span><span class="copy"><Icon name="copy" size={15} /></span></div>
  <pre><code><slot /></code></pre>
</div>
<style>
  .code { background: var(--term-bg); color: var(--term-ink); border-radius: var(--r-md); overflow: hidden; margin: 18px 0; }
  .bar { display: flex; justify-content: space-between; align-items: center; height: 34px; padding: 0 14px; background: var(--term-bar); font: 500 11.5px/1 var(--font-mono); color: #9aa6a3; letter-spacing: .04em; }
  .copy { display: grid; }
  pre { margin: 0; padding: 16px 18px; overflow-x: auto; font-size: 13px; line-height: 1.65; }
  code { font-family: var(--font-mono); }
  .code :global(.c) { color: var(--term-dim); }
  .code :global(.u) { color: var(--term-green); }
  .code :global(.k) { color: #f3bb88; }
</style>
