---
import './tokens.css';
import './base.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
interface Props { title: string; description: string; chrome?: boolean }
const { title, description, chrome = true } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfbf8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    {chrome && <Header />}
    <slot />
    {chrome && <Footer />}
  </body>
</html>
