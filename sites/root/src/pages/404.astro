---
import Layout from '@popug/design/Layout.astro';
---
<Layout title="Page not found — Popug Cloud" description="The page you requested does not exist.">
  <main class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="h1">Page not found</h1>
      <p class="lead nfp">The page you are looking for does not exist or has moved.</p>
      <a class="btn btn-primary" href="/">Back to home</a>
    </div>
  </main>
</Layout>
<style is:global>
  .nfp { margin: 16px 0 24px; }
</style>
