# container registry endpoint
root * /var/www/html
encode zstd gzip

header {
	-Server
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "no-referrer"
}

@v2 path /v2 /v2/*
handle @v2 {
	header Content-Type "application/json; charset=utf-8"
	header Docker-Distribution-Api-Version "registry/2.0"
	header WWW-Authenticate "Bearer realm=\"https://@@DOMAIN@@/v2/token\",service=\"@@DOMAIN@@\""
	header Cache-Control "no-store"
	header X-Request-Id "{http.request.uuid}"
	respond `{"errors":[{"code":"UNAUTHORIZED","message":"authentication required","detail":null}]}` 401
}

handle /assets/* {
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}

handle {
	header Cache-Control "no-cache"
	file_server
}

handle_errors {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	header Cache-Control "no-cache"
	rewrite * /404.html
	file_server
}
