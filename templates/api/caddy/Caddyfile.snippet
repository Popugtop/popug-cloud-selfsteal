# JSON API gateway
root * /var/www/html

header {
	-Server
	Strict-Transport-Security "max-age=31536000"
	X-Content-Type-Options "nosniff"
	X-Request-Id "{http.request.uuid}"
}

@root path /
handle @root {
	header Cache-Control "no-store"
	header Content-Type "application/json; charset=utf-8"
	respond `{"service":"popug-api","status":"ok","version":"@@VERSION@@"}` 200
}

@health path /health /healthz
handle @health {
	header Cache-Control "no-store"
	header Content-Type "application/json; charset=utf-8"
	respond `{"status":"ok"}` 200
}

@v1 path /v1 /v1/*
handle @v1 {
	header Cache-Control "no-store"
	header Content-Type "application/json; charset=utf-8"
	header WWW-Authenticate `Bearer realm="popug-api"`
	respond `{"error":{"code":"unauthorized","message":"Missing or invalid API token."}}` 401
}

@files path /robots.txt /favicon.svg
handle @files {
	header Cache-Control "public, max-age=86400"
	file_server
}

handle {
	header Cache-Control "no-store"
	header Content-Type "application/json; charset=utf-8"
	respond `{"error":{"code":"not_found","message":"The requested resource does not exist."}}` 404
}
